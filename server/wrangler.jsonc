{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zombiewar-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  // Deploy pushes this block wholesale, so it -- not the dashboard -- is what
  // observability actually is. Toggling Traces on in the dashboard without
  // declaring it here works until the next deploy silently turns it back off.
  //
  // Traces are on because the room's interesting failures are timing ones (a
  // late seat, a match that ends while someone is still replaying frames), and
  // a log line records that something happened while a span records when and
  // for how long. head_sampling_rate stays at the default 1: a room pumps 20
  // frames a second but only a handful of those are *invocations*, and a
  // sampled-away trace is exactly the one nobody can get back.
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    }
  },

  // *.workers.dev is DNS-poisoned on mainland Chinese networks -- it resolves to
  // addresses outside Cloudflare's ranges and simply times out, while pages.dev
  // and cloudflare.com on the same connection are fine. A custom domain on a
  // zone in this account gets real Cloudflare anycast addresses and is
  // reachable, so the game's players can actually connect. Do not fall back to
  // the workers.dev hostname for anything player-facing.
  "routes": [
    {
      "pattern": "zombiewar-api.lumentechnologies.stream",
      "custom_domain": true
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zombiewar",
      // From `wrangler d1 create zombiewar` (APAC region).
      "database_id": "7531a10f-6178-4ca1-a699-0cf8ee16adf2",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomDurableObject"
      }
    ]
  },

  // SQLite-backed Durable Objects are the only class available on the Workers
  // free plan, and they are what a room needs anyway: the room's authoritative
  // state is small and must survive the object being evicted between matches.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    }
  ],

  "vars": {
    // Comma-separated origin allowlist, or "*" while developing. The Godot web
    // export is served from Pages on a different origin than this Worker, so
    // every browser request here is cross-origin and CORS is not optional.
    "ZW_CORS_ORIGIN": "*",
    "ZW_MAX_LEADERBOARD_LIMIT": "100",
    "ZW_SESSION_TTL_SECONDS": "604800"
  }
}
