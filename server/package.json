{
  "name": "zombiewar-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker backend for zombiewar: anonymous identity, leaderboards, rooms and the 20Hz frame relay",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply zombiewar --local",
    "db:remote": "wrangler d1 migrations apply zombiewar --remote",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wrangler": "^3.99.0"
  }
}
