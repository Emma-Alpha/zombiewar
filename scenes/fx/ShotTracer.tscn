[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/fx/shot_tracer.gd" id="1_tracer"]

[sub_resource type="Shader" id="Shader_tracer"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_add, depth_draw_never;

instance uniform float lifetime_alpha : hint_range(0.0, 1.0) = 1.0;
uniform float muzzle_alpha : hint_range(0.0, 1.0) = 0.0;
uniform float hit_alpha : hint_range(0.0, 1.0) = 1.0;
varying float tracer_progress;

void vertex() {
	tracer_progress = clamp(0.5 - VERTEX.z, 0.0, 1.0);
}

void fragment() {
	float longitudinal_alpha = mix(
		muzzle_alpha,
		hit_alpha,
		smoothstep(0.0, 1.0, tracer_progress)
	);
	vec3 tracer_color = mix(
		vec3(1.0, 0.45, 0.05),
		vec3(1.0, 0.78, 0.18),
		tracer_progress
	);
	ALBEDO = tracer_color;
	EMISSION = tracer_color * 3.0;
	ALPHA = longitudinal_alpha * lifetime_alpha;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_tracer"]
shader = SubResource("Shader_tracer")
shader_parameter/muzzle_alpha = 0.0
shader_parameter/hit_alpha = 1.0

[sub_resource type="BoxMesh" id="BoxMesh_tracer"]
size = Vector3(0.035, 0.035, 1)

[node name="ShotTracer" type="MeshInstance3D"]
physics_interpolation_mode = 2
visible = false
cast_shadow = 0
