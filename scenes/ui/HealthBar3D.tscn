[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/health_bar_3d.gd" id="1_health_bar"]

[sub_resource type="Shader" id="Shader_background"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, depth_test_disabled;

uniform vec4 tint_color : source_color = vec4(0.06, 0.08, 0.10, 0.35);

void fragment() {
	vec2 centered_uv = abs(UV - vec2(0.5)) - vec2(0.42, 0.42);
	float corner_distance = length(max(centered_uv, vec2(0.0)));
	float alpha = 1.0 - smoothstep(0.07, 0.09, corner_distance);
	ALBEDO = tint_color.rgb;
	ALPHA = tint_color.a * alpha;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_background"]
resource_local_to_scene = true
shader = SubResource("Shader_background")
shader_parameter/tint_color = Color(0.06, 0.08, 0.1, 0.35)

[sub_resource type="QuadMesh" id="QuadMesh_background"]
size = Vector2(1.1, 0.1)

[sub_resource type="Shader" id="Shader_fill"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, depth_test_disabled;

uniform vec4 tint_color : source_color = vec4(0.262745, 0.811765, 0.4, 1.0);
uniform float fill_ratio : hint_range(0.0, 1.0) = 1.0;

void fragment() {
	float safe_ratio = max(fill_ratio, 0.0001);
	vec2 fill_uv = vec2(UV.x / safe_ratio, UV.y);
	vec2 centered_uv = abs(fill_uv - vec2(0.5)) - vec2(0.42, 0.42);
	float corner_distance = length(max(centered_uv, vec2(0.0)));
	float rounded_alpha = 1.0 - smoothstep(0.07, 0.09, corner_distance);
	float visible_alpha = step(UV.x, fill_ratio);
	ALBEDO = tint_color.rgb;
	ALPHA = tint_color.a * rounded_alpha * visible_alpha;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_fill"]
resource_local_to_scene = true
render_priority = 1
shader = SubResource("Shader_fill")

[sub_resource type="QuadMesh" id="QuadMesh_fill"]
size = Vector2(1.1, 0.1)

[node name="HealthBar3D" type="Node3D"]
script = ExtResource("1_health_bar")

[node name="Background" type="MeshInstance3D" parent="."]
cast_shadow = 0
