[gd_scene load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/ui/health_bar_3d.gd" id="1_health_bar"]

[sub_resource type="Shader" id="Shader_background"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, depth_draw_never, depth_test_disabled;

uniform vec4 tint_color : source_color = vec4(0.06, 0.08, 0.10, 0.88);

void vertex() {
	vec3 model_scale = vec3(
		length(MODEL_MATRIX[0].xyz),
		length(MODEL_MATRIX[1].xyz),
		length(MODEL_MATRIX[2].xyz)
	);
	MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
		INV_VIEW_MATRIX[0] * model_scale.x, INV_VIEW_MATRIX[1] * model_scale.y,
		INV_VIEW_MATRIX[2] * model_scale.z, MODEL_MATRIX[3]
	);
}

void fragment() {
	vec2 centered_uv = abs(UV - vec2(0.5)) - vec2(0.42, 0.42);
	float corner_distance = length(max(centered_uv, vec2(0.0)));
	float alpha = 1.0 - smoothstep(0.07, 0.09, corner_distance);
	ALBEDO = tint_color.rgb;
	ALPHA = tint_color.a * alpha;
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_background"]
resource_local_to_scene = true
shader = SubResource("Shader_background")

[sub_resource type="QuadMesh" id="QuadMesh_background"]
size = Vector2(1.1, 0.1)

